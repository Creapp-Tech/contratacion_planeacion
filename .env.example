# URL del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (o anon key) del proyecto Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxx

# Dominio interno para convertir "usuario" en email de Supabase Auth
AUTH_EMAIL_DOMAIN=app.local

# Solo servidor: API admin de Supabase (crear/editar/borrar usuarios en Auth)
SUPABASE_SERVICE_ROLE_KEY=
