# Variables de entorno para Planeación y Contratación

# Supabase - Públicas (expuestas al cliente)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dominio interno para convertir "usuario" en email de Supabase Auth
AUTH_EMAIL_DOMAIN=app.local

# Supabase - Solo servidor (NUNCA exponer al cliente, NO usar NEXT_PUBLIC_)
# Requerida para operaciones administrativas (gestión de usuarios en Auth, etc.)
SUPABASE_SERVICE_ROLE_KEY=
